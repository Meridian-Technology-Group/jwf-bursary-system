        <!-- ===================== NOTES (front) ===================== -->
        <mxCell id="NOTE_IMP" value="&lt;b&gt;Impersonation&lt;/b&gt; — for the ~10 applicants per cohort who need hands-on help, Charlotte can 'Open as / View as applicant' and edit via the normal form. Edits are audited as &lt;i&gt;assessor-impersonating-applicant&lt;/i&gt;. After a material change she emails the applicant to review &amp; submit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#E0C84E;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5b4a12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="NOTE_COMP" value="&lt;b&gt;Complete&lt;/b&gt; is a distinct state: all work done but Submit not yet pressed — so Charlotte can send a quick nudge instead of a full follow-up." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#E0C84E;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5b4a12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="910" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="NOTE_SR" value="&lt;b&gt;Submitted&lt;/b&gt; = brand-new application.&lt;br&gt;&lt;b&gt;Received&lt;/b&gt; = rollover (existing account with prior rounds)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#E0C84E;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5b4a12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="345" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="NOTE_GUARD" value="Assessment can begin &lt;b&gt;only&lt;/b&gt; once the application is Submitted or Received — never while it is in progress." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#E0C84E;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5b4a12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="945" y="486" width="330" height="44" as="geometry" />
        </mxCell>
        <mxCell id="NOTE_B1" value="&lt;b&gt;Offered&lt;/b&gt; → account Active. A schedule of future rounds is attached (Yrs 10–13 with due dates). The portal shows this calendar; the prior application is view-only (no edit / download)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#E0C84E;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5b4a12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="706" width="235" height="78" as="geometry" />
        </mxCell>
        <mxCell id="NOTE_WD" value="&lt;b&gt;Withdrawal&lt;/b&gt; — at any point Charlotte can Close the account (family / account level, no documents required)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#E0C84E;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5b4a12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="792" width="235" height="64" as="geometry" />
        </mxCell>

        <!-- Legend + title -->
        <mxCell id="LEG" value="&lt;b&gt;KEY&lt;/b&gt;&lt;br&gt;Actor (edge colour):&amp;nbsp; &lt;font color='#1565C0'&gt;━━&lt;/font&gt; Applicant&amp;nbsp;&amp;nbsp; &lt;font color='#B8862A'&gt;━━&lt;/font&gt; Charlotte / Assessor&amp;nbsp;&amp;nbsp; &lt;font color='#7B3FA0'&gt;━━&lt;/font&gt; School / Admissions&amp;nbsp;&amp;nbsp; &lt;font color='#5F6B7A'&gt;┅┅&lt;/font&gt; System (automatic)&lt;br&gt;Track (node border):&amp;nbsp; &lt;font color='#2E5C9A'&gt;■ Application&lt;/font&gt;&amp;nbsp;&amp;nbsp; &lt;font color='#1F7A6B'&gt;■ Assessment&lt;/font&gt;&amp;nbsp;&amp;nbsp; &lt;font color='#B8862A'&gt;■ Bursary Account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa3ad;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#222222;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1150" y="20" width="690" height="78" as="geometry" />
        </mxCell>
        <mxCell id="TIT" value="Bursary Application Flow — Actors &amp; State Transitions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0D1B2A;" vertex="1" parent="1">
