        <mxCell id="NOTE_ROUNDS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF1;strokeColor=#ECDCB6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontColor=#6e5212;arcSize=6;" value="&lt;b&gt;Round schedule&lt;/b&gt;&lt;br&gt;Always displays the full span &lt;b&gt;Yr 6 → Yr 13&lt;/b&gt; (8 possible rounds); years outside the award are greyed out.&lt;br&gt;• &lt;b&gt;Standard bursaries&lt;/b&gt; start at Yr 6, 7, 9 or 12.&lt;br&gt;• &lt;b&gt;Internal bursaries&lt;/b&gt; can start at any year.&lt;br&gt;Funding length: &lt;b&gt;max 8 years&lt;/b&gt; (Yr 6 entry) · &lt;b&gt;min 1 year&lt;/b&gt;." vertex="1">
          <mxGeometry height="110" width="440" x="555" y="1150" as="geometry" />
