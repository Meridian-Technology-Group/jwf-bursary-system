        <mxCell id="SUB" value="Three parallel state tracks. Edge colour = the actor who acts; node border colour = which track the state belongs to." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#44505e;" vertex="1" parent="1">
