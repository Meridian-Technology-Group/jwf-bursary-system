/// CALC-01 — the eight notional cost-of-living lines the v2 engine's
/// notional-spend module (CALC-03) reads per family category (Appendix A).
enum NotionalCostType {
  RENT
  COUNCIL_TAX
  ESSENTIALS
  CAR
  PUBLIC_TRANSPORT
  JWF_ALLOWANCE
  NOTIONAL_SAVINGS
  SAVINGS_CUSHION
}

/// CALC-02 — v2 rent notional add-back type (workbook C57), replacing v1's
/// binary `Assessment.isMortgageFree`-style reliance for v2 assessments.
/// NONE = no add-back; FULL_MORTGAGE_FREE / FULL_RENT_FREE = +100% add-back;
/// PARTIAL_LOWER_RENT = +25% add-back (assessor judges which applies).
enum RentAddBackType {
  NONE
  FULL_MORTGAGE_FREE
  FULL_RENT_FREE
  PARTIAL_LOWER_RENT
}
