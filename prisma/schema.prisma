generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Extends Supabase Auth user with application-specific profile data.
/// id matches auth.users.id.
model Profile {
  id                      String                   @id @default(uuid()) @db.Uuid
  role                    Role                     @default(APPLICANT)
  firstName               String?                  @map("first_name")
  lastName                String?                  @map("last_name")
  email                   String                   @unique
  phone                   String?
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedApplications    Application[]            @relation("ApplicationAssignee")
  applicationsAsLead      Application[]            @relation("ApplicationLeadApplicant")
  applicationsClosed      Application[]            @relation("ApplicationClosedBy")
  assessmentsAsOwner      Assessment[]             @relation("AssessmentAssessor")
  auditLogs               AuditLog[]
  bursaryAccounts         BursaryAccount[]
  documentsUploaded       Document[]
  emailTemplateUpdates    EmailTemplate[]
  emailTemplatesCreated   EmailTemplate[]          @relation("EmailTemplateCreator")
  invitationsCreated      Invitation[]             @relation("InvitationCreator")
  staffInvitationsCreated StaffInvitation[]        @relation("StaffInvitationCreator")
  contributorLinks        ApplicationContributor[] @relation("ContributorProfile")
  contributorsInvited     ApplicationContributor[] @relation("ContributorInvitedBy")
  contacts                Contact[]                @relation("ContactProfile")
  contactsCreated         Contact[]                @relation("ContactCreator")

  @@map("profiles")
}

/// An assessment cycle for one academic year.
model Round {
  id                               String           @id @default(uuid()) @db.Uuid
  academicYear                     String           @unique @map("academic_year")
  openDate                         DateTime         @map("open_date") @db.Date
  closeDate                        DateTime         @map("close_date") @db.Date
  decisionDate                     DateTime?        @map("decision_date") @db.Date
  /// LEGACY, NO READERS (Epic 13 / E1, D13-8). The single round-level default
  /// submission-by date, superseded by the two application-type-aware columns
  /// below. Retained for one release only so E1 can be rolled back without data
  /// loss; the follow-up PR (E1b) drops it once staging is verified — the same
  /// two-step precedent as Epic 01 PR-6 / #177. Still WRITTEN (mirrored from
  /// `defaultSubmissionDeadlineNew`) so a code rollback lands on a sane value,
  /// but nothing reads it. Do not add a reader.
  defaultSubmissionDeadline        DateTime?        @map("default_submission_deadline") @db.Date
  /// Round-level default submission-by date for NEW applications (D13-8,
  /// date-only, optional). Every `applicationType = NEW` application in the
  /// round inherits this unless it has its own `Application.submissionDeadlineAt`
  /// override. Derived (not copied) at read time by
  /// `effectiveSubmissionDeadline()` (src/lib/rounds/submission-deadline.ts),
  /// which resolves the full chain:
  ///   application.submissionDeadlineAt (override)
  ///     ?? endOfDay(round default FOR THIS APPLICATION TYPE)  (THIS)
  ///     ?? endOfDay(round.closeDate)                          (fallback — D-1)
  /// NULL means the round has no NEW default; those applications fall through
  /// to the close-date fallback above.
  defaultSubmissionDeadlineNew     DateTime?        @map("default_submission_deadline_new") @db.Date
  /// Round-level default submission-by date for ROLLING_OVER (re-assessment)
  /// applications (D13-8, date-only, optional). Q4 (Brian, 2026-08-14): this is
  /// ONE GLOBAL date per round, conventionally in April — deliberately NOT
  /// per-school, so two columns on `Round` are the whole model. Same three-tier
  /// derivation and same NULL semantics as `defaultSubmissionDeadlineNew`.
  defaultSubmissionDeadlineRolling DateTime?        @map("default_submission_deadline_rolling") @db.Date
  status                           RoundStatus      @default(DRAFT)
  createdAt                        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  applications                     Application[]
  invitations                      Invitation[]
  recommendations                  Recommendation[]

  @@map("rounds")
}

/// A persistent account per child, spanning multiple assessment years.
///
/// Epic 13, D13-1a: the account is an INTERNAL container for awarded
/// applicants and exposes NO reference or ID to the user — its identity is
/// this UUID primary key, and the one user-facing label lives on
/// `Application.reference`. The former `reference` (`BA-…`) and CALC-10
/// `feesAccountCode` columns were dropped by
/// `20260814140000_bursary_account_drop_identifiers`; sibling-picker and
/// report surfaces show `childName` instead.
model BursaryAccount {
  id                   String                 @id @default(uuid()) @db.Uuid
  school               School
  childName            String                 @map("child_name")
  childDob             DateTime?              @map("child_dob") @db.Date
  entryYear            Int                    @map("entry_year")
  entryYearGroup       EntryYearGroup?        @map("entry_year_group")
  firstAssessmentYear  String                 @map("first_assessment_year")
  /// Agreed forward-schedule horizon N (Epic 10, D19) — number of future
  /// assessment years generated on AWARD. NULL for legacy accounts created
  /// before the schedule landed.
  scheduleYears        Int?                   @map("schedule_years")
  benchmarkPayableFees Decimal?               @map("benchmark_payable_fees") @db.Decimal(10, 2)
  leadApplicantId      String                 @map("lead_applicant_id") @db.Uuid
  status               BursaryAccountStatus   @default(ACTIVE)
  closedAt             DateTime?              @map("closed_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  applications         Application[]
  leadApplicant        Profile                @relation(fields: [leadApplicantId], references: [id])
  invitations          Invitation[]
  recommendations      Recommendation[]
  siblingLinks         SiblingLink[]
  contacts             Contact[]
  scheduleEntries      BursaryScheduleEntry[]

  @@index([leadApplicantId])
  @@map("bursary_accounts")
}

/// Epic 10 — one row per future assessment year for a rolling bursary account
/// (the application-lifecycle illustration's Year 1..N grid). Generated on
/// AWARD; future rows materialise into Rounds one year at a time (Epic 03).
model BursaryScheduleEntry {
  id               String              @id @default(uuid()) @db.Uuid
  bursaryAccountId String              @map("bursary_account_id") @db.Uuid
  scheduleYear     Int                 @map("schedule_year")
  academicYear     String              @map("academic_year")
  type             ScheduleEntryType   @default(ANNUAL)
  status           ScheduleEntryStatus @default(SCHEDULED)
  manuallyCreated  Boolean             @default(false) @map("manually_created")
  availableOn      DateTime?           @map("available_on") @db.Date
  requiredBy       DateTime?           @map("required_by") @db.Date
  receivedOn       DateTime?           @map("received_on") @db.Date
  showOnPortal     Boolean             @default(false) @map("show_on_portal")
  roundId          String?             @map("round_id") @db.Uuid
  applicationId    String?             @map("application_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  bursaryAccount   BursaryAccount      @relation(fields: [bursaryAccountId], references: [id], onDelete: Cascade)

  @@unique([bursaryAccountId, scheduleYear])
  @@index([bursaryAccountId])
  @@index([roundId])
  @@map("bursary_schedule_entries")
}

/// One application per child per round.
model Application {
  id                        String                   @id @default(uuid()) @db.Uuid
  /// The ONE user-facing label for this application (Epic 13, D13-1a). It is a
  /// LABEL, NOT AN IDENTITY: identity is `id`, and no FK anywhere points here.
  /// Defaults to `{Child} – {School} – {Year group} – {Academic year}` (see
  /// lib/applications/reference.ts) and is freely editable by ADMIN at any
  /// lifecycle stage, including after award — its primary use is being re-set
  /// to the external fees-system code (e.g. `TS-SMITH05-Smith, Bob`) for
  /// reconciliation. **NOT UNIQUE at any layer**: duplicates are legitimate, so
  /// migration 20260814120000_application_reference_non_unique dropped both the
  /// `@unique` and the `lower(reference)` unique index and replaced the latter
  /// with a non-unique functional index (`applications_reference_lower_idx`,
  /// invisible here — Prisma cannot express a functional index).
  reference                 String
  roundId                   String                   @map("round_id") @db.Uuid
  bursaryAccountId          String?                  @map("bursary_account_id") @db.Uuid
  contactId                 String?                  @map("contact_id") @db.Uuid
  leadApplicantId           String                   @map("lead_applicant_id") @db.Uuid
  school                    School
  childName                 String                   @map("child_name")
  childDob                  DateTime?                @map("child_dob") @db.Date
  entryYear                 Int?                     @map("entry_year")
  entryYearGroup            EntryYearGroup?          @map("entry_year_group")
  isReassessment            Boolean                  @default(false) @map("is_reassessment")
  isInternal                Boolean                  @default(false) @map("is_internal")
  formStatus                ApplicationFormStatus    @default(CREATED) @map("form_status")
  applicationType           ApplicationType          @default(NEW) @map("application_type")
  /// Shared-custody arrangement (Epic 09, Decision D15). SOLE is the default
  /// (single resident parent/guardian, or a two-resident-parent household).
  /// SHARED_5050 ⇒ both natural parents are lead applicants (either may hold
  /// the account); SHARED_MAIN_LIMITED ⇒ the main-custody parent is the lead.
  /// Additive/non-null with a SOLE default so existing rows are unaffected; the
  /// "either may hold the account" rule is policy (see lib/household/rules.ts),
  /// not a second lead FK — the one-account-per-child unique is NOT widened.
  custodyArrangement        CustodyArrangement       @default(SOLE) @map("custody_arrangement")
  archivedAt                DateTime?                @map("archived_at") @db.Timestamptz(6)
  submittedAt               DateTime?                @map("submitted_at") @db.Timestamptz(6)
  /// When the parent accepted the Terms & Conditions for THIS submission
  /// (Epic 05, Decision D10). NULL until submitted. Stamped at submit and
  /// rendered into the submitted summary + submission PDF. Additive/nullable.
  termsAcceptedAt           DateTime?                @map("terms_accepted_at") @db.Timestamptz(6)
  /// Which T&Cs document/version the parent accepted at submission (D10), so a
  /// later document swap never rewrites a historic acceptance. See
  /// lib/portal/terms.ts (TERMS_AND_CONDITIONS_VERSION).
  termsVersion              String?                  @map("terms_version")
  /// Consumed-flag for the ONE-TIME submission PDF (Epic 13, D13-4). NULL ⇒ the
  /// applicant's single download is unspent; NOT NULL ⇒ when it was taken, and
  /// GET /api/pdf/submission/[id] answers 410 Gone from then on, permanently.
  /// Stamped by a conditional UPDATE (… WHERE submission_pdf_downloaded_at IS
  /// NULL) run ONLY after `renderToBuffer` has succeeded, so a failed render
  /// never consumes the download and concurrent requests resolve to exactly one
  /// winner. Additive/nullable, never backfilled — see migration
  /// 20260814160000_application_submission_pdf_downloaded_at.
  submissionPdfDownloadedAt DateTime?                @map("submission_pdf_downloaded_at") @db.Timestamptz(6)
  /// Per-applicant submit-by override (Epic 03). NULL ⇒ fall back to
  /// round.closeDate. Distinct from Assessment.pausedUntil (post-submission
  /// doc deadline, Epic 01) and from Round.closeDate (round-level intake
  /// window). Read via effectiveSubmissionDeadline() — never compared raw.
  submissionDeadlineAt      DateTime?                @map("submission_deadline_at") @db.Timestamptz(6)
  /// Unified Closed state (item 2). NULL ⇒ not closed. Set exactly once by
  /// `closeApplication` (never rewritten — the original close is immutable,
  /// mirroring BursaryAccount.closedAt). closedAt != null takes precedence
  /// over every other derived review phase (CLOSED wins). A close always
  /// carries a close reason; the reason's purgeOnClose flag decides whether
  /// the close also anonymised PII (purgedAt below).
  closedAt                  DateTime?                @map("closed_at") @db.Timestamptz(6)
  closedById                String?                  @map("closed_by") @db.Uuid
  closeReasonId             String?                  @map("close_reason_id") @db.Uuid
  /// Stamped when the reason-driven close purge (item 10) ran for this
  /// application — the idempotency gate: a second close/purge attempt no-ops.
  purgedAt                  DateTime?                @map("purged_at") @db.Timestamptz(6)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedToId              String?                  @map("assigned_to_id") @db.Uuid
  sections                  ApplicationSection[]
  assignedTo                Profile?                 @relation("ApplicationAssignee", fields: [assignedToId], references: [id])
  bursaryAccount            BursaryAccount?          @relation(fields: [bursaryAccountId], references: [id])
  contact                   Contact?                 @relation(fields: [contactId], references: [id])
  leadApplicant             Profile                  @relation("ApplicationLeadApplicant", fields: [leadApplicantId], references: [id])
  closedBy                  Profile?                 @relation("ApplicationClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closeReason               CloseReason?             @relation(fields: [closeReasonId], references: [id], onDelete: Restrict)
  round                     Round                    @relation(fields: [roundId], references: [id])
  assessment                Assessment?
  documents                 Document[]
  contributors              ApplicationContributor[]
  invitations               Invitation[]

  // One application per child per round, keyed including DOB so twins (same
  // first name, distinct DOB) no longer collide (Epic 04, D12). This composite
  // unique enforces the non-NULL-DOB case. A SEPARATE raw PARTIAL unique index
  // (applications_round_lead_child_null_dob_key, WHERE child_dob IS NULL —
  // created in migration 20260605210000_application_dob_unique) forbids two
  // same-name rows that BOTH have NULL DOB, so Postgres NULL-distinctness can't
  // weaken the dedupe for legacy/unknown-DOB rows. Together they fully replace
  // the old childName-only unique without weakening it.
  @@unique([roundId, leadApplicantId, childName, childDob])
  // Replaces the old (round_id, status) index (Epic 01 PR-6b): the deprecated
  // fused `status` column is dropped; the round queue/cockpit now filters on the
  // authoritative form lifecycle, so the index follows it to keep the same
  // round-scoped access pattern.
  @@index([roundId, formStatus])
  @@index([leadApplicantId])
  @@index([bursaryAccountId])
  @@index([assignedToId])
  @@map("applications")
}

/// Stores applicant-entered form data per section as JSONB.
///
/// `ownerContributorId` identifies which contributor (parent) owns this
/// section's data. It is backfilled to the PRIMARY contributor for all
/// existing rows (see migration). The column is nullable and the
/// `@@unique([applicationId, section])` constraint is unchanged for now:
/// the dual-parent feature relaxes the constraint and wires the write path
/// to populate this column in a later PR (PR 4 — restricted secondary
/// portal), where multiple contributors can own distinct copies of the
/// parent-financial sections. Nothing reads this column until then.
model ApplicationSection {
  id                 String                 @id @default(uuid()) @db.Uuid
  applicationId      String                 @map("application_id") @db.Uuid
  ownerContributorId String                 @map("owner_contributor_id") @db.Uuid
  section            ApplicationSectionType
  data               Json                   @default("{}")
  isComplete         Boolean                @default(false) @map("is_complete")
  /// CR-001 edit-on-behalf: flat dot-path map of fields entered/amended by
  /// staff on the applicant's behalf, e.g.
  /// `{ "parent1Income.salary": { editedBy, editedByName, editedAt } }`.
  /// Merged on each staff save; cleared per-path when the applicant
  /// re-edits that field pre-submission.
  assessorProvenance Json                   @default("{}") @map("assessor_provenance")
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  application        Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ownerContributor   ApplicationContributor @relation(fields: [ownerContributorId], references: [id], onDelete: Cascade)

  @@unique([applicationId, section, ownerContributorId])
  @@index([ownerContributorId])
  @@map("application_sections")
}

/// Links a parent/guardian Profile to an Application as a contributor.
///
/// Supports the dual-parent (separated/divorced) case: each application has
/// exactly one PRIMARY contributor (the lead applicant, who owns the child's
/// data and receives all communications) and AT MOST one SECONDARY contributor
/// (a second parent who supplies only their own financials and documents).
///
/// The "at most one of each role per application" rule is enforced by
/// `@@unique([applicationId, role])`. A given profile can only be linked once
/// per application (`@@unique([applicationId, profileId])`).
///
/// Introduced additively: the PRIMARY row is backfilled for every existing
/// application. The SECONDARY role and its associated portal/RLS/assessment
/// behaviour are wired up in subsequent PRs.
model ApplicationContributor {
  id            String                       @id @default(uuid()) @db.Uuid
  applicationId String                       @map("application_id") @db.Uuid
  profileId     String                       @map("profile_id") @db.Uuid
  role          ApplicationContributorRole
  status        ApplicationContributorStatus @default(INVITED)
  invitedById   String?                      @map("invited_by_id") @db.Uuid
  invitedAt     DateTime?                    @map("invited_at") @db.Timestamptz(6)
  submittedAt   DateTime?                    @map("submitted_at") @db.Timestamptz(6)
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  application   Application                  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  profile       Profile                      @relation("ContributorProfile", fields: [profileId], references: [id])
  invitedBy     Profile?                     @relation("ContributorInvitedBy", fields: [invitedById], references: [id])
  sections      ApplicationSection[]
  documents     Document[]

  @@unique([applicationId, role])
  @@unique([applicationId, profileId])
  @@index([applicationId])
  @@index([profileId])
  @@map("application_contributors")
}

/// Metadata for uploaded files. Files stored in Supabase Storage.
///
/// `uploadedByContributorId` anchors the document to the contributor (PRIMARY
/// or SECONDARY) who uploaded it, so the document route handlers can scope
/// cross-contributor access by a direct equality check rather than re-deriving
/// the uploader's role at access time (dual-parent feature, PR 4b). Nullable:
/// a NULL describes a legacy row (pre-PR-4b) and is treated as PRIMARY-owned.
model Document {
  id                      String                  @id @default(uuid()) @db.Uuid
  applicationId           String                  @map("application_id") @db.Uuid
  slot                    String
  filename                String
  mimeType                String                  @map("mime_type")
  fileSize                Int                     @map("file_size")
  storagePath             String                  @map("storage_path")
  isVerified              Boolean                 @default(false) @map("is_verified")
  uploadedBy              String                  @map("uploaded_by") @db.Uuid
  uploadedByContributorId String?                 @map("uploaded_by_contributor_id") @db.Uuid
  uploadedAt              DateTime                @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  application             Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploader                Profile                 @relation(fields: [uploadedBy], references: [id])
  uploadedByContributor   ApplicationContributor? @relation(fields: [uploadedByContributorId], references: [id], onDelete: SetNull)

  @@index([applicationId, slot])
  @@index([uploadedByContributorId])
  @@map("documents")
}

/// Core assessor workspace. Stores all financial data and calculation results.
model Assessment {
  id                            String                @id @default(uuid()) @db.Uuid
  applicationId                 String                @unique @map("application_id") @db.Uuid
  assessorId                    String                @map("assessor_id") @db.Uuid
  familyTypeCategory            Int?                  @map("family_type_category")
  /// CALC-02 — dispatches v1 vs v2 engine (architecture decision #1). `1` = the
  /// existing abridged 4-stage calculator (default, untouched); `2` = the full
  /// notional model (CALC-03..06), stamped at assessment creation from CALC-07
  /// onward. Every engine call site branches on this value.
  calculationVersion            Int                   @default(1) @map("calculation_version")
  notionalRent                  Decimal?              @map("notional_rent") @db.Decimal(10, 2)
  utilityCosts                  Decimal?              @map("utility_costs") @db.Decimal(10, 2)
  foodCosts                     Decimal?              @map("food_costs") @db.Decimal(10, 2)
  annualFees                    Decimal?              @map("annual_fees") @db.Decimal(10, 2)
  councilTax                    Decimal?              @map("council_tax") @db.Decimal(10, 2)
  schoolingYearsRemaining       Int?                  @map("schooling_years_remaining")
  totalHouseholdNetIncome       Decimal?              @map("total_household_net_income") @db.Decimal(10, 2)
  netAssetsYearlyValuation      Decimal?              @map("net_assets_yearly_valuation") @db.Decimal(10, 2)
  hndiAfterNs                   Decimal?              @map("hndi_after_ns") @db.Decimal(10, 2)
  requiredBursary               Decimal?              @map("required_bursary") @db.Decimal(10, 2)
  /// CALC-02 — v2 notional toggles/inputs (all nullable; v1 assessments never
  /// set these). `rentAddBackType` replaces v1's binary `isMortgageFree` add-back
  /// for v2 (CALC-03 §notional-spend); the other flags gate their respective
  /// notional deduction lines. See implementation-plan.md §CALC-02.
  rentAddBackType               RentAddBackType?      @map("rent_add_back_type")
  multiPropertyRentAddBack      Boolean?              @map("multi_property_rent_add_back")
  councilTaxSupport             Boolean?              @map("council_tax_support")
  usesCar                       Boolean?              @map("uses_car")
  usesPublicTransport           Boolean?              @map("uses_public_transport")
  feeInsuranceAnnual            Decimal?              @map("fee_insurance_annual") @db.Decimal(10, 2)
  behindOnFees                  Boolean?              @map("behind_on_fees")
  /// CALC-02 — v2 snapshot columns (CALC-03..06 outputs). All nullable; only
  /// populated for `calculationVersion: 2` assessments. `debtOverNdiRatio` and
  /// `lifestyleSqueezeRatio` carry extra decimal precision (ratios, not £).
  notionalEssentials            Decimal?              @map("notional_essentials") @db.Decimal(10, 2)
  notionalCar                   Decimal?              @map("notional_car") @db.Decimal(10, 2)
  notionalPublicTransport       Decimal?              @map("notional_public_transport") @db.Decimal(10, 2)
  notionalJwfAllowance          Decimal?              @map("notional_jwf_allowance") @db.Decimal(10, 2)
  notionalSavingsBenchmark      Decimal?              @map("notional_savings_benchmark") @db.Decimal(10, 2)
  savingsTestNumber             Decimal?              @map("savings_test_number") @db.Decimal(10, 2)
  totalNotionalSpend            Decimal?              @map("total_notional_spend") @db.Decimal(10, 2)
  ndiAfterNotionalSpend         Decimal?              @map("ndi_after_notional_spend") @db.Decimal(10, 2)
  derivedYearlyDebtRepayments   Decimal?              @map("derived_yearly_debt_repayments") @db.Decimal(10, 2)
  yearlyDebtExposure            Decimal?              @map("yearly_debt_exposure") @db.Decimal(10, 2)
  debtOverNdiRatio              Decimal?              @map("debt_over_ndi_ratio") @db.Decimal(10, 4)
  debtStatusLabel               String?               @map("debt_status_label")
  incomeCategory                Int?                  @map("income_category")
  propertyCategoryDerived       Int?                  @map("property_category_derived")
  propertyEquityCategory        Int?                  @map("property_equity_category")
  financialEquityLabel          String?               @map("financial_equity_label")
  lifestyleSqueezeRatio         Decimal?              @map("lifestyle_squeeze_ratio") @db.Decimal(10, 4)
  lifestyleSqueezeLabel         String?               @map("lifestyle_squeeze_label")
  actualRemainingDi             Decimal?              @map("actual_remaining_di") @db.Decimal(10, 2)
  theoreticalBenchmarkDi        Decimal?              @map("theoretical_benchmark_di") @db.Decimal(10, 2)
  affordabilityAdjustedDi       Decimal?              @map("affordability_adjusted_di") @db.Decimal(10, 2)
  recommendedPayableFees        Decimal?              @map("recommended_payable_fees") @db.Decimal(10, 2)
  grossFees                     Decimal?              @map("gross_fees") @db.Decimal(10, 2)
  scholarshipPct                Decimal?              @default(0) @map("scholarship_pct") @db.Decimal(5, 2)
  bursaryAward                  Decimal?              @map("bursary_award") @db.Decimal(10, 2)
  netYearlyFees                 Decimal?              @map("net_yearly_fees") @db.Decimal(10, 2)
  vatRate                       Decimal?              @default(20.00) @map("vat_rate") @db.Decimal(5, 2)
  yearlyPayableFees             Decimal?              @map("yearly_payable_fees") @db.Decimal(10, 2)
  monthlyPayableFees            Decimal?              @map("monthly_payable_fees") @db.Decimal(10, 2)
  /// Epic 07: next-year fee snapshot. `nextYearAnnualFees` is the resolved
  /// following-academic-year gross fee (from the fee-year resolver); the payable
  /// figures mirror the current-year breakdown but against the higher gross
  /// (scholarship %/bursary held flat — D14 default). Persisted on save so the
  /// recommendation/PDF (Epic 08) can show the uplift without recomputation.
  /// All additive + nullable; null for rows saved before this column existed.
  nextYearAnnualFees            Decimal?              @map("next_year_annual_fees") @db.Decimal(10, 2)
  nextYearYearlyPayableFees     Decimal?              @map("next_year_yearly_payable_fees") @db.Decimal(10, 2)
  nextYearMonthlyPayableFees    Decimal?              @map("next_year_monthly_payable_fees") @db.Decimal(10, 2)
  manualAdjustment              Decimal?              @default(0) @map("manual_adjustment") @db.Decimal(10, 2)
  manualAdjustmentReason        String?               @map("manual_adjustment_reason")
  /// Epic 06: single qualitative narrative for the assessment. Replaces the six
  /// AssessmentChecklist tabs and the Recommendation family_synopsis/summary as
  /// the editable surface. Visible during assessment and on the completed /
  /// recommendation screens; remains editable AFTER the assessment is COMPLETED
  /// (its read-only rule is relaxed in the UI; the server action is always
  /// permissive). Backfilled from the eight legacy boxes (those columns are
  /// retained, read-only, until the 08 cutover). Additive + nullable.
  synopsis                      String?               @map("synopsis")
  /// CALC-10 — "Assessor's wizard — things to look out for with this family"
  /// (workbook §3.16). Forward-looking notes for NEXT year's assessor,
  /// distinct from `synopsis` (this year's narrative). On the account's next
  /// assessment, the most recent COMPLETED assessment's notes for the same
  /// `BursaryAccount` render as a prominent callout (see
  /// `src/lib/assessment/watch-out-notes.ts`). Additive/nullable.
  watchOutNotes                 String?               @map("watch_out_notes")
  propertyCategory              Int?                  @map("property_category")
  propertyExceedsThreshold      Boolean               @default(false) @map("property_exceeds_threshold")
  dishonestyFlag                Boolean               @default(false) @map("dishonesty_flag")
  creditRiskFlag                Boolean               @default(false) @map("credit_risk_flag")
  secondaryParentOverride       Boolean               @default(false) @map("secondary_parent_override")
  secondaryParentOverrideReason String?               @map("secondary_parent_override_reason")
  status                        AssessmentStatus      @default(NOT_STARTED)
  outcome                       AssessmentOutcome?
  pausedUntil                   DateTime?             @map("paused_until") @db.Timestamptz(6)
  completedAt                   DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt                     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  checklists                    AssessmentChecklist[]
  earners                       AssessmentEarner[]
  property                      AssessmentProperty?
  application                   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessor                      Profile               @relation("AssessmentAssessor", fields: [assessorId], references: [id])
  recommendation                Recommendation?

  @@map("assessments")
}

/// Income breakdown per earner (Parent 1 / Parent 2).
model AssessmentEarner {
  id                     String           @id @default(uuid()) @db.Uuid
  assessmentId           String           @map("assessment_id") @db.Uuid
  earnerLabel            EarnerLabel      @map("earner_label")
  employmentStatus       EmploymentStatus @map("employment_status")
  netPay                 Decimal          @default(0) @map("net_pay") @db.Decimal(10, 2)
  netDividends           Decimal          @default(0) @map("net_dividends") @db.Decimal(10, 2)
  netSelfEmployedProfit  Decimal          @default(0) @map("net_self_employed_profit") @db.Decimal(10, 2)
  pensionAmount          Decimal          @default(0) @map("pension_amount") @db.Decimal(10, 2)
  benefitsIncluded       Decimal          @default(0) @map("benefits_included") @db.Decimal(10, 2)
  benefitsIncludedDetail Json             @default("{}") @map("benefits_included_detail")
  benefitsExcluded       Decimal          @default(0) @map("benefits_excluded") @db.Decimal(10, 2)
  benefitsExcludedDetail Json             @default("{}") @map("benefits_excluded_detail")
  totalIncome            Decimal          @default(0) @map("total_income") @db.Decimal(10, 2)
  /// CALC-02 — v2 status-driven sub-table record (`AssessorIncomeRecord`,
  /// src/types/assessment-v2.ts), mirroring the parent-form `ParentIncomeRecord`
  /// pattern (architecture decision #2). Nullable/additive; the 6 legacy numeric
  /// buckets above remain untouched and keep powering v1.
  incomeDetail           Json?            @map("income_detail")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessment             Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, earnerLabel])
  @@map("assessment_earners")
}

/// Property and savings data for Stage 2 calculations.
model AssessmentProperty {
  id                        String     @id @default(uuid()) @db.Uuid
  assessmentId              String     @unique @map("assessment_id") @db.Uuid
  isMortgageFree            Boolean    @default(false) @map("is_mortgage_free")
  additionalPropertyCount   Int        @default(0) @map("additional_property_count")
  additionalPropertyIncome  Decimal    @default(0) @map("additional_property_income") @db.Decimal(10, 2)
  cashSavings               Decimal    @default(0) @map("cash_savings") @db.Decimal(10, 2)
  isasPepsShares            Decimal    @default(0) @map("isas_peps_shares") @db.Decimal(10, 2)
  schoolAgeChildrenCount    Int        @default(1) @map("school_age_children_count")
  derivedSavingsAnnualTotal Decimal    @default(0) @map("derived_savings_annual_total") @db.Decimal(10, 2)
  /// CALC-02 — v2 itemised JSONB (`PropertyAssetsRecord`, src/types/assessment-v2.ts):
  /// `{ home: {value, mortgageBalance}, second: {...}, other: {...} }` (aggregate
  /// "other" per workbook C101/C102). Nullable/additive.
  propertyAssets            Json?      @map("property_assets")
  /// CALC-02 — v2 itemised JSONB (`DebtsRecord`, src/types/assessment-v2.ts):
  /// `{ creditCards, loans, leaseBalances, schoolFeesOwedOrOther }`. Nullable/additive.
  debts                     Json?
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessment                Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_properties")
}

/// Qualitative context tabs with free-text notes.
model AssessmentChecklist {
  id           String       @id @default(uuid()) @db.Uuid
  assessmentId String       @map("assessment_id") @db.Uuid
  tab          ChecklistTab
  notes        String       @default("")
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, tab])
  @@map("assessment_checklists")
}

/// Structured recommendation output per assessment.
model Recommendation {
  id                      String                     @id @default(uuid()) @db.Uuid
  assessmentId            String                     @unique @map("assessment_id") @db.Uuid
  bursaryAccountId        String?                    @map("bursary_account_id") @db.Uuid
  roundId                 String                     @map("round_id") @db.Uuid
  familySynopsis          String?                    @map("family_synopsis")
  accommodationStatus     String?                    @map("accommodation_status")
  incomeCategory          String?                    @map("income_category")
  propertyCategory        Int?                       @map("property_category")
  bursaryAward            Decimal?                   @map("bursary_award") @db.Decimal(10, 2)
  /// Distinct merit/academic scholarship award (£), recorded alongside the
  /// means-tested bursary award (Epic 08, Decision D9). Additive/nullable —
  /// NULL means no scholarship award was recorded for this recommendation.
  /// The 0–100 Assessment.scholarshipPct remains the fee-calculation lever; this
  /// is the recorded £ figure the rolling account carries forward (Epic 10).
  scholarshipAward        Decimal?                   @map("scholarship_award") @db.Decimal(10, 2)
  yearlyPayableFees       Decimal?                   @map("yearly_payable_fees") @db.Decimal(10, 2)
  monthlyPayableFees      Decimal?                   @map("monthly_payable_fees") @db.Decimal(10, 2)
  dishonestyFlag          Boolean                    @default(false) @map("dishonesty_flag")
  creditRiskFlag          Boolean                    @default(false) @map("credit_risk_flag")
  summary                 String?
  /// CALC-02 — v2 min-of-three award + gap tracking (CALC-06, CALC-08). All
  /// nullable/additive; null for every v1 recommendation.
  recommendedPayableFees  Decimal?                   @map("recommended_payable_fees") @db.Decimal(10, 2)
  confirmedPayableFees    Decimal?                   @map("confirmed_payable_fees") @db.Decimal(10, 2)
  gapAmount               Decimal?                   @map("gap_amount") @db.Decimal(10, 2)
  lastPayableFees         Decimal?                   @map("last_payable_fees") @db.Decimal(10, 2)
  scholarshipValueInclVat Decimal?                   @map("scholarship_value_incl_vat") @db.Decimal(10, 2)
  bursarySpendBeforeVat   Decimal?                   @map("bursary_spend_before_vat") @db.Decimal(10, 2)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  reasonCodes             RecommendationReasonCode[]
  gapReasons              RecommendationGapReason[]
  assessment              Assessment                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  bursaryAccount          BursaryAccount?            @relation(fields: [bursaryAccountId], references: [id])
  round                   Round                      @relation(fields: [roundId], references: [id])

  @@map("recommendations")
}

/// Reason codes for year-on-year changes.
model ReasonCode {
  id              String                     @id @default(uuid()) @db.Uuid
  code            Int                        @unique
  label           String
  isDeprecated    Boolean                    @default(false) @map("is_deprecated")
  sortOrder       Int                        @map("sort_order")
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  recommendations RecommendationReasonCode[]

  @@map("reason_codes")
}

/// Junction table: Recommendation ↔ ReasonCode.
model RecommendationReasonCode {
  recommendationId String         @map("recommendation_id") @db.Uuid
  reasonCodeId     String         @map("reason_code_id") @db.Uuid
  reasonCode       ReasonCode     @relation(fields: [reasonCodeId], references: [id])
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@id([recommendationId, reasonCodeId])
  @@map("recommendation_reason_codes")
}

/// CALC-02 — Reference: reasons for a gap between the recommended (min-of-three)
/// and confirmed payable fees (Appendix E). Mirrors `ReasonCode`'s shape exactly.
model GapReason {
  id              String                    @id @default(uuid()) @db.Uuid
  code            Int                       @unique
  label           String
  isDeprecated    Boolean                   @default(false) @map("is_deprecated")
  sortOrder       Int                       @map("sort_order")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  recommendations RecommendationGapReason[]

  @@map("gap_reasons")
}

/// Junction table: Recommendation ↔ GapReason. Required (≥1) whenever a
/// recommendation's `gapAmount` is non-zero (CALC-08). Mirrors
/// `RecommendationReasonCode`.
model RecommendationGapReason {
  recommendationId String         @map("recommendation_id") @db.Uuid
  gapReasonId      String         @map("gap_reason_id") @db.Uuid
  gapReason        GapReason      @relation(fields: [gapReasonId], references: [id])
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@id([recommendationId, gapReasonId])
  @@map("recommendation_gap_reasons")
}

/// Links bursary accounts as siblings for sequential income absorption.
model SiblingLink {
  id               String         @id @default(uuid()) @db.Uuid
  familyGroupId    String         @map("family_group_id") @db.Uuid
  bursaryAccountId String         @map("bursary_account_id") @db.Uuid
  priorityOrder    Int            @map("priority_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  bursaryAccount   BursaryAccount @relation(fields: [bursaryAccountId], references: [id])

  @@unique([familyGroupId, bursaryAccountId])
  @@unique([familyGroupId, priorityOrder])
  @@map("sibling_links")
}

/// Reference: Family type configs with notional rent, utilities, food.
model FamilyTypeConfig {
  id            String   @id @default(uuid()) @db.Uuid
  category      Int
  description   String
  notionalRent  Decimal  @map("notional_rent") @db.Decimal(10, 2)
  utilityCosts  Decimal  @map("utility_costs") @db.Decimal(10, 2)
  foodCosts     Decimal  @map("food_costs") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([category, effectiveFrom])
  @@map("family_type_configs")
}

/// Reference: School annual fees (pre-VAT).
model SchoolFees {
  id            String   @id @default(uuid()) @db.Uuid
  school        School
  annualFees    Decimal  @map("annual_fees") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([school, effectiveFrom])
  @@map("school_fees")
}

/// Reference: Council tax default (Band D Croydon).
model CouncilTaxDefault {
  id            String   @id @default(uuid()) @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  description   String   @default("Band D Croydon")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("council_tax_defaults")
}

/// CALC-01 — Reference: notional cost-of-living figures per family category
/// (Appendix A), versioned by `effectiveFrom` like the other reference tables.
/// Feeds the v2 notional-spend engine (CALC-03); `costType` picks out which
/// line of the workbook's notional block this row is (rent, council tax,
/// essentials composite, car, public transport, JWF allowance, the notional
/// savings benchmark, and the savings-cushion allowance shown for context).
model NotionalCostConfig {
  id            String           @id @default(uuid()) @db.Uuid
  category      Int
  costType      NotionalCostType @map("cost_type")
  amount        Decimal          @db.Decimal(10, 2)
  effectiveFrom DateTime         @map("effective_from") @db.Date
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([category, costType, effectiveFrom])
  @@map("notional_cost_configs")
}

/// CALC-01 — Reference: family-category metadata (Appendix A row 1) — the
/// household shape each of the 6 notional-cost categories represents. Feeds
/// the default `schoolAgeChildrenCount` used by `calculateDerivedSavings`
/// (v1, reused as-is in v2) when not overridden by the assessor.
model FamilyCategoryMeta {
  id                String   @id @default(uuid()) @db.Uuid
  category          Int
  familyMembers     Int      @map("family_members")
  schoolAgeChildren Int      @map("school_age_children")
  description       String
  effectiveFrom     DateTime @map("effective_from") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([category, effectiveFrom])
  @@map("family_category_metas")
}

/// CALC-01 — Reference: affordability grid (Appendix B) driving the
/// "affordability-adjusted DI" leg of the min-of-three award rule (CALC-06).
/// `basePct` is the category-1 base percentage; the category adjustment
/// (`basePct − 0.5 × (category−1)`) is applied by the engine, not stored here.
/// Every row in this table has a real, non-null `bandFloor`/`bandCeiling` —
/// the grid's own outside-range handling (≤£27k / >£105k, assumption
/// CALC-A6) is implemented in the CALC-06 award engine, not as sentinel rows
/// here. See `src/lib/assessment/reference-bands.ts` for the shared band
/// resolution convention (floor-inclusive, ceiling-inclusive, ties broken
/// toward the lower band).
model AffordabilityBand {
  id            String   @id @default(uuid()) @db.Uuid
  bandFloor     Decimal  @map("band_floor") @db.Decimal(10, 2)
  bandCeiling   Decimal  @map("band_ceiling") @db.Decimal(10, 2)
  basePct       Decimal  @map("base_pct") @db.Decimal(5, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bandFloor, effectiveFrom])
  @@map("affordability_bands")
}

/// CALC-01 — Reference: income-category bands + fees-benchmark % (Appendix
/// C.1; merges PROFILING tables 1 + 6 — same bands). `bandFloor`/`bandCeiling`
/// are nullable to represent the open-ended bottom (<27,000) and top
/// (≥120,000) bands. Bands are floor-inclusive, CEILING-EXCLUSIVE per the
/// appendix's own note — the one table that differs from the other bands'
/// inclusive/inclusive convention; see `reference-bands.ts`. The
/// 1,2,3,4,5,6,7,7,8,7,8 category tail (category 7 reappearing after 8) is the
/// workbook's own anomaly, preserved verbatim per assumption CALC-A1.
model IncomeCategoryBand {
  id               String   @id @default(uuid()) @db.Uuid
  bandFloor        Decimal? @map("band_floor") @db.Decimal(10, 2)
  bandCeiling      Decimal? @map("band_ceiling") @db.Decimal(10, 2)
  category         Int
  feesBenchmarkPct Decimal  @map("fees_benchmark_pct") @db.Decimal(5, 2)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bandCeiling, effectiveFrom])
  @@map("income_category_bands")
}

/// CALC-01 — Reference: property-equity category bands (Appendix C.2).
/// `bandFloor` null on the bottom (no/negative equity → category 1);
/// `bandCeiling` null on the top (>£1.6m → category 12). Floor-inclusive,
/// ceiling-inclusive; see `reference-bands.ts`.
model PropertyEquityBand {
  id            String   @id @default(uuid()) @db.Uuid
  bandFloor     Decimal? @map("band_floor") @db.Decimal(12, 2)
  bandCeiling   Decimal? @map("band_ceiling") @db.Decimal(12, 2)
  category      Int
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bandCeiling, effectiveFrom])
  @@map("property_equity_bands")
}

/// CALC-01 — Reference: financial-equity labels (Appendix C.3). The workbook
/// carries a genuine isolated single-point band ("0 → no debt, no equity")
/// wedged between "<0 → in debt" and "0–50k → some savings"; represented here
/// with the "in debt" row's `bandCeiling` set one penny below zero (-0.01) so
/// the £0.00-exactly row resolves unambiguously to "no debt, no equity" — the
/// only band table needing this penny-epsilon (money is genuinely quantised
/// to the penny, so this isn't a fudge). See `reference-bands.ts`.
model FinancialEquityBand {
  id            String   @id @default(uuid()) @db.Uuid
  bandFloor     Decimal? @map("band_floor") @db.Decimal(12, 2)
  bandCeiling   Decimal? @map("band_ceiling") @db.Decimal(12, 2)
  label         String
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bandCeiling, effectiveFrom])
  @@map("financial_equity_bands")
}

/// CALC-01 — Reference: debt-over-NDI ratio bands (Appendix C.4), normalised
/// to non-overlapping ranges per assumption CALC-A3 (the workbook's own
/// 0.1–1/0.3–1/0.5–1/0.8–1 all shared a common upper bound of 1). `ratioFloor`
/// null on the bottom (≤0 → zero debt); `ratioCeiling` null on the top (>10).
/// `minRepaymentMonths` is null only for the "n/a" zero-debt row; the "<1mo"
/// row is stored as 0. Floor-inclusive, ceiling-inclusive; see
/// `reference-bands.ts`.
model DebtRatioBand {
  id                 String   @id @default(uuid()) @db.Uuid
  ratioFloor         Decimal? @map("ratio_floor") @db.Decimal(7, 4)
  ratioCeiling       Decimal? @map("ratio_ceiling") @db.Decimal(7, 4)
  minRepaymentMonths Int?     @map("min_repayment_months")
  statusLabel        String   @map("status_label")
  effectiveFrom      DateTime @map("effective_from") @db.Date
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ratioCeiling, effectiveFrom])
  @@map("debt_ratio_bands")
}

/// CALC-01 — Reference: lifestyle-squeeze ratio bands (Appendix C.5), stored
/// as percentage points (100 = 100%) to match the appendix's own "%" labels.
/// `ratioCeiling` null on the top (>170%). Floor-inclusive, ceiling-inclusive;
/// see `reference-bands.ts`.
model LifestyleSqueezeBand {
  id            String   @id @default(uuid()) @db.Uuid
  ratioFloor    Decimal? @map("ratio_floor") @db.Decimal(6, 2)
  ratioCeiling  Decimal? @map("ratio_ceiling") @db.Decimal(6, 2)
  statusLabel   String   @map("status_label")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ratioCeiling, effectiveFrom])
  @@map("lifestyle_squeeze_bands")
}

/// Reference: Reasons an application/bursary account can be closed for
/// (item 4.3). Drives the unified close action (items 2/4): `purgeOnClose`
/// decides whether closing with this reason purges the applicant's PII
/// (item 10) or retains all data under the normal retention policy. Reasons
/// are soft-deactivated via `isDeprecated` — never hard-deleted — so a
/// closed application recorded against a reason keeps showing that reason's
/// label even after it is removed from the picker (Story 4.4). No relation
/// to Application yet; the FK arrives with the close action itself (A3).
model CloseReason {
  id           String        @id @default(uuid()) @db.Uuid
  /// Unique natural key (close_reasons_label_key) — the idempotent
  /// seed upserts by label; there is no numeric code like reason_codes.
  label        String        @unique
  purgeOnClose Boolean       @default(false) @map("purge_on_close")
  isDeprecated Boolean       @default(false) @map("is_deprecated")
  sortOrder    Int           @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  applications Application[]

  @@map("close_reasons")
}

/// Admin-managed lead-applicant contact: the pre-application record of a
/// family (parent + child + school + entry year + address). Exists
/// independently of any Application; it is the source from which an
/// invitation and a pre-filled, school/year-LOCKED application are seeded
/// (Epic 04, D1). The child name + DOB form the per-child identity key so
/// twins (same name, distinct DOB) get distinct contacts (D12).
model Contact {
  id String @id @default(uuid()) @db.Uuid

  // Parent (lead applicant) — identity & reachability. lastName required.
  title     String? @map("title")
  firstName String? @map("first_name")
  lastName  String  @map("last_name")
  email     String  @map("email")
  phone     String? @map("phone")

  // Child — name (required) + DOB form the per-child identity key (twins).
  // `childName` is the derived single-string backing store (first + surname)
  // kept for existing consumers (invitations, applications); the split
  // title/first/surname fields are the entry fields.
  childTitle     String?   @map("child_title")
  childFirstName String?   @map("child_first_name")
  childLastName  String?   @map("child_last_name")
  childName      String    @map("child_name")
  childDob       DateTime? @map("child_dob") @db.Date

  // School & year — set by admin, LOCKED for the parent (D1).
  school         School
  entryYear      Int             @map("entry_year")
  entryYearGroup EntryYearGroup? @map("entry_year_group")

  // Home address — structured, so the portal can show the stored address
  // when the child is "at the same address" (Epic 02 reads it).
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  town         String? @map("town")
  postcode     String? @map("postcode")

  // Linkage — bound to a Profile once the family registers; to an account
  // once they hold a bursary. Both nullable: a contact precedes both.
  profileId        String? @map("profile_id") @db.Uuid
  bursaryAccountId String? @map("bursary_account_id") @db.Uuid

  notes      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile        Profile?        @relation("ContactProfile", fields: [profileId], references: [id])
  bursaryAccount BursaryAccount? @relation(fields: [bursaryAccountId], references: [id])
  creator        Profile         @relation("ContactCreator", fields: [createdBy], references: [id])
  invitations    Invitation[]
  applications   Application[]

  // One contact per child per lead applicant: name + DOB disambiguates twins.
  // NOTE: profileId is nullable (a contact precedes registration) and Postgres
  // treats NULLs as DISTINCT in unique indexes, so this constraint does NOT
  // dedupe two not-yet-bound contacts for the same child. The friendly
  // "already a contact for that child" guard lives in createContactAction,
  // scoped by creator, to catch that case at the app layer before binding.
  @@unique([profileId, childName, childDob])
  @@index([email])
  @@index([profileId])
  @@index([bursaryAccountId])
  @@index([createdBy])
  @@map("contacts")
}

/// Tracks invitations sent by assessors.
model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  email            String
  firstName        String?          @map("first_name")
  lastName         String?          @map("last_name")
  childName        String?          @map("child_name")
  school           School?
  roundId          String?          @map("round_id") @db.Uuid
  bursaryAccountId String?          @map("bursary_account_id") @db.Uuid
  contactId        String?          @map("contact_id") @db.Uuid
  applicationId    String?          @map("application_id") @db.Uuid
  authUserId       String?          @map("auth_user_id") @db.Uuid
  entryYear        Int?             @map("entry_year")
  entryYearGroup   EntryYearGroup?  @map("entry_year_group")
  token            String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  bursaryAccount   BursaryAccount?  @relation(fields: [bursaryAccountId], references: [id])
  contact          Contact?         @relation(fields: [contactId], references: [id])
  application      Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creator          Profile          @relation("InvitationCreator", fields: [createdBy], references: [id])
  round            Round?           @relation(fields: [roundId], references: [id])

  @@index([token])
  @@index([email])
  @@index([applicationId])
  @@index([contactId])
  @@map("invitations")
}

/// Tracks staff invitations (ADMIN / ASSESSOR / VIEWER) sent via the
/// branded Resend flow. Separate from Invitation (which tracks applicant
/// invitations) to keep the data shapes cleanly partitioned.
model StaffInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  email      String
  role       Role
  firstName  String?          @map("first_name")
  lastName   String?          @map("last_name")
  token      String           @unique
  authUserId String           @map("auth_user_id") @db.Uuid
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdBy  String           @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  inviter    Profile          @relation("StaffInvitationCreator", fields: [createdBy], references: [id])

  @@index([token])
  @@index([email])
  @@map("staff_invitations")
}

/// Configurable email templates with merge fields.
/// System templates (`isSystem: true`) are seeded via the
/// `*_seed_email_templates` migrations and keyed one-to-one to
/// `EmailTemplateType` (`type` NOT NULL, `@unique`) — every send-path
/// `findUnique({ where: { type } })` call depends on that invariant.
/// Custom templates (`isSystem: false`, admin-created) carry `type: null`
/// and are identified by `name` instead; the unique index on `type` still
/// holds because Postgres treats NULLs as distinct. `name` uniqueness among
/// ACTIVE custom templates is enforced by a partial index
/// (`email_templates_name_active_key`, case-insensitive, `name IS NOT NULL
/// AND deleted_at IS NULL`) defined in raw SQL — not expressible in the
/// Prisma schema DSL.
model EmailTemplate {
  id          String             @id @default(uuid()) @db.Uuid
  type        EmailTemplateType? @unique
  /// Admin-facing label for a custom template. Null for system templates
  /// (those are labelled via TEMPLATE_LABELS keyed off `type` in the UI).
  name        String?
  subject     String
  body        String
  enabled     Boolean            @default(true) @map("enabled")
  mergeFields Json               @map("merge_fields")
  /// True for the 16 seeded system templates; false for admin-created ones.
  isSystem    Boolean            @default(true) @map("is_system")
  /// Soft-delete tombstone for custom templates (system templates are
  /// non-deletable — see setEmailTemplateEnabledAction / deleteEmailTemplateAction).
  /// A re-run of the seed migration and getAllEmailTemplates both respect this.
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdBy   String?            @map("created_by") @db.Uuid
  updatedBy   String?            @map("updated_by") @db.Uuid
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator     Profile?           @relation("EmailTemplateCreator", fields: [createdBy], references: [id])
  updater     Profile?           @relation(fields: [updatedBy], references: [id])

  @@map("email_templates")
}

/// Immutable append-only audit log.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  context    String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       Profile? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum Role {
  APPLICANT
  ASSESSOR
  VIEWER
  DELETED
  ADMIN
}

enum School {
  TRINITY
  WHITGIFT
}

/// School year-group at which a child enters (spec §4). The numeric year-group
/// determines total schooling years, running to the end of Year 13 / Upper
/// Sixth (Years 6–13): Y6→8, Y7→7, Y9→5, Y12→2; see
/// `src/lib/assessment/schooling-years.ts`. OTHER is the escape hatch for
/// unusual cohorts — schooling years are then entered manually by the assessor.
enum EntryYearGroup {
  Y6
  Y7
  Y9
  Y12
  OTHER
}

enum RoundStatus {
  DRAFT
  OPEN
  CLOSED
}

/// Form lifecycle for an Application (Epic 01).
/// CREATED → NOT_STARTED → IN_PROGRESS → FILLED_IN → SUBMITTED.
enum ApplicationFormStatus {
  CREATED
  NOT_STARTED
  IN_PROGRESS
  FILLED_IN
  SUBMITTED
}

/// Whether an Application is a brand-new application or a rolling-over
/// reassessment of an existing BursaryAccount (Epic 01). Replaces the
/// inferred `bursaryAccountId == null` + `isReassessment` heuristic.
enum ApplicationType {
  NEW
  ROLLING_OVER
}

/// Shared-custody arrangement for an Application (Epic 09, Decision D15).
///   SOLE                — single resident parent/guardian, or a single
///                         two-resident-parent household (the default).
///   SHARED_5050         — 50/50 shared custody; both natural parents are lead
///                         applicants (either may hold the account).
///   SHARED_MAIN_LIMITED — main + limited custody; the main-custody parent is
///                         the lead, both natural parents are assessed.
enum CustodyArrangement {
  SOLE
  SHARED_5050
  SHARED_MAIN_LIMITED
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum AssessmentOutcome {
  /// VESTIGIAL (Epic 01 PR-6b): the legacy binary `QUALIFIES` value is fully
  /// unused — 0 rows on nonprod (residuals remapped to AWARDED /
  /// QUALIFIES_NOT_AWARDED in PR-6a) and no code references. Removing a value
  /// from an in-use Postgres enum requires a risky new-enum-swap, so it is left
  /// in place. Safe to drop later via an enum swap once confidence is high.
  QUALIFIES
  DOES_NOT_QUALIFY
  QUALIFIES_NOT_AWARDED
  AWARDED
}

enum EarnerLabel {
  PARENT_1
  PARENT_2
}

enum ApplicationContributorRole {
